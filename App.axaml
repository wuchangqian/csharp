<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CSharpLearningProject.App"
             xmlns:local="using:CSharpLearningProject"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <!-- 菜单按钮样式 -->
        <StyleInclude Source="avares://CSharpLearningProject/Styles.axaml" />
    </Application.Styles>
</Application>
