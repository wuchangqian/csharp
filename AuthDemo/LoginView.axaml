<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CSharpLearningProject.AuthDemo"
        x:Class="CSharpLearningProject.AuthDemo.LoginView"
        x:DataType="vm:LoginViewModel"
        Title="登录 —— SQLite + bcrypt 验证"
        Width="380" Height="300"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="32,32">

        <TextBlock Grid.Row="0"
                   Text="AuthDemo 登录"
                   Foreground="white"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,20"/>

        <TextBox Grid.Row="1"
                 Text="{Binding Username, Mode=TwoWay}"
                 Watermark="用户名"
                 Margin="0,0,0,12"
                 Background="#0f0f1a"
                 Foreground="#e0e0e0"
                 BorderBrush="#333"/>

        <TextBox Grid.Row="2"
                 Text="{Binding Password, Mode=TwoWay}"
                 PasswordChar="●"
                 Watermark="密码"
                 Margin="0,0,0,12"
                 Background="#0f0f1a"
                 Foreground="#e0e0e0"
                 BorderBrush="#333"/>

        <Button Grid.Row="3"
                Content="登录"
                Command="{Binding LoginCommand}"
                HorizontalAlignment="Stretch"
                Background="#16213e"
                Foreground="white"
                Margin="0,0,0,8"/>

        <TextBlock Grid.Row="4"
                   Text="{Binding ErrorMessage}"
                   Foreground="#ff6b6b"
                   FontSize="12"
                   TextWrapping="Wrap"/>

        <TextBlock Grid.Row="5"
                   Text="默认账号: admin / 123456"
                   Foreground="#666"
                   FontSize="11"
                   Margin="0,12,0,0"/>
    </Grid>
</Window>
