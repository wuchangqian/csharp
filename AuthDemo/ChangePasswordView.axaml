<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CSharpLearningProject.AuthDemo"
        x:Class="CSharpLearningProject.AuthDemo.ChangePasswordView"
        x:DataType="vm:ChangePasswordViewModel"
        Title="修改密码"
        Width="380" Height="360"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#1a1a2e">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="32,32">

        <TextBlock Grid.Row="0"
                   Text="修改密码"
                   Foreground="white"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,20"/>

        <TextBox Grid.Row="1"
                 Text="{Binding OldPassword, Mode=TwoWay}"
                 PasswordChar="●"
                 Watermark="旧密码"
                 Margin="0,0,0,12"
                 Background="#0f0f1a"
                 Foreground="#e0e0e0"
                 BorderBrush="#333"/>

        <TextBox Grid.Row="2"
                 Text="{Binding NewPassword, Mode=TwoWay}"
                 PasswordChar="●"
                 Watermark="新密码"
                 Margin="0,0,0,12"
                 Background="#0f0f1a"
                 Foreground="#e0e0e0"
                 BorderBrush="#333"/>

        <TextBox Grid.Row="3"
                 Text="{Binding ConfirmPassword, Mode=TwoWay}"
                 PasswordChar="●"
                 Watermark="确认新密码"
                 Margin="0,0,0,12"
                 Background="#0f0f1a"
                 Foreground="#e0e0e0"
                 BorderBrush="#333"/>

        <Button Grid.Row="4"
                Content="确认修改"
                Command="{Binding SubmitCommand}"
                HorizontalAlignment="Stretch"
                Background="#16213e"
                Foreground="white"
                Margin="0,0,0,8"/>

        <TextBlock Grid.Row="5"
                   Text="{Binding ErrorMessage}"
                   Foreground="#ff6b6b"
                   FontSize="12"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
